# LLM API 配置（以 OpenAI 兼容 API 为例）
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# Embedding API 配置（可选，阶段 2 接入 MemoryCore Gateway 时使用）
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_API_KEY=your-api-key-here
# EMBEDDING_MODEL=text-embedding-3-small

# 多模态 2D 定位源（第 38 周 P0 选型用，可选）
# 每个源可单独指定 端点/密钥/模型名/坐标约定；未指定的项回退到上面的 LLM_API_*。
# 变量名前缀 = VLM_<源名大写、非字母数字转下划线>_ ；源名即 --models 里用的名字。
# 坐标约定取值：auto | pixel | normalized_1000 | normalized_1（Qwen-VL 系列官方用 0–1000 归一化）
# VLM_SOURCES=gui-plus,qwen3-vl-plus
# VLM_GUI_PLUS_API_BASE=https://maas.qianwenaiapi.com/compatible-mode/v1
# VLM_GUI_PLUS_API_KEY=your-api-key-here
# VLM_GUI_PLUS_MODEL=gui-plus
# VLM_GUI_PLUS_COORD_SPACE=pixel
# VLM_QWEN3_VL_PLUS_API_BASE=https://maas.qianwenaiapi.com/compatible-mode/v1
# VLM_QWEN3_VL_PLUS_API_KEY=your-api-key-here
# VLM_QWEN3_VL_PLUS_MODEL=qwen3-vl-plus
# VLM_QWEN3_VL_PLUS_COORD_SPACE=normalized_1000
